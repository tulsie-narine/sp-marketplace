# Copy to .env.local and fill in values from your Supabase project
# (Dashboard -> Project Settings -> API). Never commit the filled-in file.

# Required by the browser client (src/integrations/supabase/client.ts).
# Vite inlines these at build time, so a rebuild is needed after changing them.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Only needed to run drizzle-kit migrations (drizzle.config.ts).
# LOVABLE_DB_MIGRATION_URL=postgresql://user:password@host:5432/postgres
